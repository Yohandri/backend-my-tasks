# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-256-bits-long
JWT_EXPIRATION=24h

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200

# Preview Channels (automatically allowed via regex)
# Pattern: https://my-tasks-4a9af--*.web.app
